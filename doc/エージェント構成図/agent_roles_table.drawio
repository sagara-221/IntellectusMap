                    <mxGeometry x="52" y="107" width="44" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="cell_c2_0" value="下位項目の分解、新しい項目の追加。大きなテーマやつまずきを、具体的な下位概念へ段階的に分解する" style="fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=12;fontColor=#334155;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="260" y="84" width="246" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="cell_c3_0" value="観点計画と子ノード生成の2段階プロンプトで知識ツリーを構築" style="fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=12;fontColor=#334155;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="506" y="84" width="272" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="cell_c1_1" value="&lt;b&gt;出題係&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #64748B;&quot;&gt;(問題出題 Agent)&lt;/span&gt;" style="fillColor=#FBFDFA;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=70;fontSize=13;fontStyle=1;fontColor=#0F172A;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="180" width="220" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="icon_1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png;base64,;" vertex="1" parent="1">
                    <mxGeometry x="52" y="203" width="44" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="cell_c2_1" value="確認問題の作成。選択した知識の理解度を確認する4択問題を生成する" style="fillColor=#FBFDFA;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=12;fontColor=#334155;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="260" y="180" width="246" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="cell_c3_1" value="到達目標と過去の出題履歴を参照し、問題の重複を抑制" style="fillColor=#FBFDFA;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=12;fontColor=#334155;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="506" y="180" width="272" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="cell_c1_2" value="&lt;b&gt;評価係&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #64748B;&quot;&gt;(回答評価 Agent)&lt;/span&gt;" style="fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=70;fontSize=13;fontStyle=1;fontColor=#0F172A;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="276" width="220" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="icon_2" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png;base64,;" vertex="1" parent="1">
                    <mxGeometry x="52" y="299" width="44" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="cell_c2_2" value="回答の採点、会話の根拠からの理解度評価。回答の正誤に加え、誤解やつまずきの可能性を分析する" style="fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=12;fontColor=#334155;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="260" y="276" width="246" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="cell_c3_2" value="選択肢の一致判定とLLMによる回答理由・発言根拠の意味採点、誤解パターンの抽出" style="fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=12;fontColor=#334155;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="506" y="276" width="272" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="cell_c1_3" value="&lt;b&gt;統合係&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #64748B;&quot;&gt;(概念統合 Agent)&lt;/span&gt;" style="fillColor=#FBFDFA;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=70;fontSize=13;fontStyle=1;fontColor=#0F172A;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="372" width="220" height="96" as="geometry"/>
                </mxCell>
