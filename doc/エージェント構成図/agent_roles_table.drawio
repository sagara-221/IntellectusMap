                    <mxGeometry x="52" y="395" width="44" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="cell_c2_3" value="知識の重複や対応関係を照合・統合。表記が異なる同一概念を判定し、重複する知識を統合する" style="fillColor=#FBFDFA;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=12;fontColor=#334155;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="260" y="372" width="246" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="cell_c3_3" value="Vertex AI Text Embeddingsで概念をベクトル化し、コサイン類似度で既存ノードと照合" style="fillColor=#FBFDFA;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=12;fontColor=#334155;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="506" y="372" width="272" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="cell_c1_4" value="&lt;b&gt;記録係&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #64748B;&quot;&gt;(根拠記録 Agent)&lt;/span&gt;" style="fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=70;fontSize=13;fontStyle=1;fontColor=#0F172A;whiteSpace=wrap;html=1;" vertex="1" parent="1">
