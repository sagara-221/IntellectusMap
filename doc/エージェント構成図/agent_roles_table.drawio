                <mxCell id="cell_c1_0" value="&lt;b&gt;分解係&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #64748B;&quot;&gt;(ノード分解 Agent)&lt;/span&gt;" style="fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=70;fontSize=13;fontStyle=1;fontColor=#0F172A;whiteSpace=wrap;html=1;" vertex="1" parent="1">
