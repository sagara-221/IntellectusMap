                    <mxGeometry x="52" y="587" width="44" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="cell_c2_5" value="探索受付でユーザーと会話する（通常の調査隊とは別配置）。自由な対話から興味やつまずきの手がかりを収集する" style="fillColor=#FBFDFA;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=12;fontColor=#334155;whiteSpace=wrap;html=1;" vertex="1" parent="1">
