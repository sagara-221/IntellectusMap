                    <mxGeometry x="52" y="491" width="44" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="cell_c2_4" value="発言から根拠を抽出し、知識項目への配置先を調べる。会話から理解の手がかりを抽出して配置先を検証する" style="fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=12;fontColor=#334155;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="260" y="468" width="246" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="cell_c3_4" value="会話ストリームから構造化抽出を行い、ベクトル検索で適切なノードへの配置案を検証" style="fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=12;fontColor=#334155;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="506" y="468" width="272" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="cell_c1_5" value="&lt;b&gt;受付係&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #64748B;&quot;&gt;(探索受付 Agent)&lt;/span&gt;" style="fillColor=#FBFDFA;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=70;fontSize=13;fontStyle=1;fontColor=#0F172A;whiteSpace=wrap;html=1;" vertex="1" parent="1">
